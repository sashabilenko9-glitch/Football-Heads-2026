#!/usr/bin/env bash
# Blocks a commit that isn't Spotless-formatted (see docs/adr/0005-quality-gate-tooling.md).
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Running Spotless format check..."
if ! ./gradlew spotlessCheck --console=plain -q; then
  echo
  echo "Formatting check failed. Run './gradlew spotlessApply', re-stage the changed files, then commit again."
  exit 1
fi
